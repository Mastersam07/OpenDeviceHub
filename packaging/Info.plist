<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>OpenDeviceHub</string>
  <key>CFBundleDisplayName</key><string>OpenDeviceHub</string>
  <key>CFBundleIdentifier</key><string>io.github.mastersam07.simviewer</string>
  <key>CFBundleExecutable</key><string>OpenDeviceHub</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleShortVersionString</key><string>__MARKETING_VERSION__</string>
  <key>CFBundleVersion</key><string>__BUILD_NUMBER__</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>NSHumanReadableCopyright</key><string>MIT licensed. Not affiliated with or endorsed by Apple.</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>

  <!-- Links that name a device. `devices` belongs to Device Hub by default; claiming it here only
       matters once someone chooses this app in Settings, and a link this app does not understand is
       handed back to Device Hub rather than swallowed. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>io.github.mastersam07.simviewer.open</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleURLSchemes</key><array><string>odhub</string></array>
    </dict>
    <dict>
      <key>CFBundleURLName</key><string>io.github.mastersam07.simviewer.devices</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleURLSchemes</key><array><string>devices</string></array>
    </dict>
  </array>

  <!-- Sparkle. The feed and the key are what make this a release build: without both, the updater
       is never created. Neither may change once a version has shipped. -->
  <key>SUFeedURL</key><string>https://mastersam07.github.io/appcast/simviewer.xml</string>
  <key>SUPublicEDKey</key><string>ZvBlUJbzcMueAq6HtYF6yq9lRrtb6BCHN+F/FWRJG4M=</string>
  <key>SUEnableAutomaticChecks</key><true/>
  <key>SUScheduledCheckInterval</key><integer>86400</integer>
  <!-- The user decides when to install. Silent installation is off deliberately. -->
  <key>SUAutomaticallyUpdate</key><false/>
</dict>
</plist>
